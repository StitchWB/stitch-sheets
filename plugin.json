      {
        "name": "exchange_oauth_code",
        "readonly": false
      }
    ],
    "ui": {
      "kind": "declarative",
      "tabs": [
        {
          "id": "sheets",
          "label": "stitch-sheets.tab",
          "icon": "Share2",
          "page": "main"
        }
      ],
      "page": {
        "title": "stitch-sheets.title",
        "nodes": [
          {
            "kind": "section",
            "title": "stitch-sheets.identities",
            "nodes": [
              {
                "kind": "table",
                "id": "identities",
                "columns": [
                  {
                    "key": "identity_id",
                    "label": "ID"
                  },
                  {
                    "key": "display_name",
                    "label": "stitch-sheets.name"
                  },
                  {
                    "key": "email",
                    "label": "Email"
                  },
                  {
                    "key": "status",
                    "label": "stitch-sheets.status"
                  }
                ],
                "source": {
                  "command": "fetch_dataset"
                },
                "rowsKey": "identitiesFlat"
              }
            ]
          },
          {
            "kind": "section",
            "title": "stitch-sheets.links",
            "nodes": [
              {
                "kind": "table",
                "id": "links",
                "columns": [
                  {
                    "key": "link_id",
                    "label": "ID"
                  },
                  {
                    "key": "identity_id",
                    "label": "stitch-sheets.identity"
                  },
                  {
                    "key": "provider",
                    "label": "stitch-sheets.provider"
                  },
                  {
                    "key": "account_id",
                    "label": "stitch-sheets.account"
                  },
                  {
                    "key": "role",
                    "label": "stitch-sheets.role"
                  },
                  {
                    "key": "status",
                    "label": "stitch-sheets.status"
                  }
                ],
                "source": {
                  "command": "fetch_dataset"
                },
                "rowsKey": "linksFlat",
                "rowActions": [
                  {
                    "id": "delete-link-row",
                    "label": "stitch-sheets.deleteRow",
                    "command": "delete_link",
                    "variant": "danger",
                    "paramsFromRow": {
                      "linkId": "link_id"
                    }
                  }
                ]
              }
            ]
          },
          {
            "kind": "section",
            "nodes": [
              {
                "kind": "button",
                "id": "connect-google",
                "label": "stitch-sheets.connect",
                "command": "start_oauth",
                "variant": "primary"
              }
            ]
          }
        ]
      }
    },
