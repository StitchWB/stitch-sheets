      },
      {
        "name": "init_schema",
        "readonly": false
      },
      {
        "name": "upsert_link",
        "readonly": false
      },
      {
        "name": "delete_link",
        "readonly": false
      },
      {
        "name": "upsert_account_link",
        "readonly": false
      },
      {
        "name": "delete_account_link",
        "readonly": false
      },
      {
        "name": "upsert_profile_link",
        "readonly": false
      },
      {
        "name": "delete_profile_link",
        "readonly": false
      },
      {
        "name": "upsert_auth_method",
        "readonly": false
      },
      {
        "name": "delete_auth_method",
        "readonly": false
      },
      {
